{
  "name": "hookrelay",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "sync": "tsx scripts/sync.ts",
    "new-sub": "tsx scripts/new-sub.ts",
    "preversion": "[ \"$(git branch --show-current)\" = main ] || { echo 'Error: npm version must be run on main'; exit 1; } && npm run typecheck && npm test",
    "postversion": "git push origin main v$npm_package_version",
    "retag": "git tag -f v$npm_package_version && git push origin v$npm_package_version --force"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.16.20",
    "@cloudflare/workers-types": "^4.20260625.1",
    "jsonc-parser": "^3.3.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9",
    "wrangler": "^4.105.0",
    "zod": "^4.4.3"
  }
}
