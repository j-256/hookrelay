{
  "name": "hookrelay",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "commands": "tsx scripts/commands.ts",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "pnpm check:docs-cover && pnpm check:boundaries && vitest run",
    "test:watch": "vitest",
    "types:generate": "wrangler types --include-env=false",
    "typecheck": "pnpm types:generate && tsc --noEmit",
    "check:docs-cover": "node scripts/check-docs-cover.mjs",
    "check:boundaries": "tsx scripts/check-dependency-boundaries.ts",
    "cloudevents:send": "tsx scripts/cloudevents-send.ts",
    "sync": "tsx scripts/sync.ts",
    "retention": "tsx scripts/retention.ts",
    "github:fleet": "tsx integrations/github-fleet/src/cli.ts",
    "new-sub": "tsx scripts/new-sub.ts",
    "sub:add": "tsx scripts/sub-add.ts",
    "github:events": "tsx scripts/providers/github/subscription-events.ts",
    "sub:retire": "tsx scripts/sub-retire.ts",
    "sink:add": "tsx scripts/sink-add.ts",
    "sink:retire": "tsx scripts/sink-retire.ts",
    "sink:rename": "tsx scripts/sink-rename.ts",
    "sink:secret:rename": "tsx scripts/sink-secret-rename.ts",
    "preversion": "[ \"$(git branch --show-current)\" = main ] || { echo 'Error: npm version must be run on main'; exit 1; } && npm run typecheck && npm test",
    "postversion": "git push --atomic origin main v$npm_package_version",
    "retag": "tsx scripts/retag.ts"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.21.2",
    "@types/node": "^26.2.0",
    "jsonc-parser": "^3.3.1",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.122.0",
    "zod": "^4.4.3"
  },
  "dependencies": {
    "postal-mime": "^3.0.0"
  }
}
