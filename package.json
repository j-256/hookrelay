{
  "name": "hookrelay",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "commands": "tsx scripts/commands.ts",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "types:generate": "wrangler types --include-env=false",
    "typecheck": "pnpm types:generate && tsc --noEmit",
    "sync": "tsx scripts/sync.ts",
    "new-sub": "tsx scripts/new-sub.ts",
    "sub:add": "tsx scripts/sub-add.ts",
    "sub:events": "tsx scripts/sub-events.ts",
    "sink:add": "tsx scripts/sink-add.ts",
    "sink:rename": "tsx scripts/sink-rename.ts",
    "sink:secret:rename": "tsx scripts/sink-secret-rename.ts",
    "preversion": "[ \"$(git branch --show-current)\" = main ] || { echo 'Error: npm version must be run on main'; exit 1; } && npm run typecheck && npm test",
    "postversion": "git push origin main v$npm_package_version",
    "retag": "git tag -f v$npm_package_version && git push origin v$npm_package_version --force"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.21.2",
    "@types/node": "^26.2.0",
    "jsonc-parser": "^3.3.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9",
    "wrangler": "^4.122.0",
    "zod": "^4.4.3"
  }
}
