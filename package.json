{
  "name": "hookrelay",
  "version": "1.5.0",
  "private": true,
  "type": "module",
  "scripts": {
    "commands": "tsx scripts/commands.ts",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "pnpm check:docs-cover && pnpm check:boundaries && pnpm test:node && vitest run",
    "test:node": "node --import tsx --test test/node/*.node.mjs integrations/github-fleet/test/*.node.mjs",
    "test:watch": "vitest",
    "types:generate": "wrangler types --include-env=false",
    "typecheck": "pnpm types:generate && tsc --noEmit",
    "check:docs-cover": "node scripts/check-docs-cover.mjs",
    "check:boundaries": "tsx scripts/check-dependency-boundaries.ts",
    "cloudevents:send": "tsx scripts/cloudevents-send.ts",
    "sync": "tsx scripts/sync.ts",
    "configuration": "tsx scripts/configuration.ts",
    "operations": "tsx scripts/operations.ts",
    "retention": "tsx scripts/retention.ts",
    "github:fleet": "tsx integrations/github-fleet/src/cli.ts",
    "github:handoff:recovery": "tsx integrations/github-fleet/src/handoff-recovery-cli.ts",
    "subscription:fleet": "tsx integrations/subscription-fleet/src/cli.ts",
    "new-sub": "tsx scripts/new-sub.ts",
    "sub:add": "tsx scripts/sub-add.ts",
    "github:events": "tsx scripts/providers/github/subscription-events.ts",
    "github:sync": "tsx scripts/providers/github/sync-events.ts",
    "sub:retire": "tsx scripts/sub-retire.ts",
    "sink:add": "tsx scripts/sink-add.ts",
    "sink:retire": "tsx scripts/sink-retire.ts",
    "sink:rename": "tsx scripts/sink-rename.ts",
    "sink:secret:rename": "tsx scripts/sink-secret-rename.ts",
    "deploy:check": "tsx scripts/release-check.ts",
    "release:check": "tsx scripts/release-check.ts",
    "preversion": "node scripts/version-preflight.mjs && npm run typecheck && npm test",
    "retag": "tsx scripts/retag.ts",
    "capture:cover": "node --import tsx tools/cover/capture.mjs",
    "github:app": "tsx scripts/github-app.ts",
    "github:operations": "tsx scripts/github-operations.ts"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.23.0",
    "@types/node": "^26.6.6",
    "jsonc-parser": "^3.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12",
    "wrangler": "^4.159.0",
    "zod": "^4.6.7"
  },
  "dependencies": {
    "postal-mime": "^4.2.1"
  }
}
