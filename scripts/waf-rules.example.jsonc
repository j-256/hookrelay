// hookrelay WAF custom rules. Copy and edit per zone, or use as-is for the canonical setup.
//
// PURPOSE: keep scanner / background-noise traffic off the Worker. A request blocked here
// terminates at Cloudflare's edge and never invokes the Worker, so it does NOT count against
// the Workers request quota (100k/day on the Free plan, account-wide). A request the Worker
// merely 404s DOES count -- so edge-blocking junk is a real cost saving, not just hygiene.
//
// STRATEGY: default-deny. Legitimate traffic on a hookrelay hostname is /hook/* (inbound
// webhooks), /admin/* (the operator, gated separately by Cloudflare Access), and /cdn-cgi/*
// (Cloudflare's own reserved path -- Access serves its login and callback flow there). Block
// everything else. This uses starts_with (allowed on all plans) rather than the regex
// `matches` operator (Business/Enterprise only), so it deploys on the Free plan.
//
// IMPORTANT: /cdn-cgi/ MUST be allowed. Cloudflare Access completes its login at
// /cdn-cgi/access/authorized on your hostname; if the WAF blocks that path, the Access flow
// dies at the callback with a "you have been blocked" page AFTER you authenticate -- which
// looks exactly like an Access policy rejection but is actually the firewall. Anything under
// /cdn-cgi/ is handled by Cloudflare itself and never reaches the Worker, so allowing it costs
// no Worker invocations.
//
// TRADEOFF: this does not block malformed /hook/<junk> paths -- those still reach the Worker
// and 404. Catching those precisely needs the slug-shape regex, which needs `matches`. A
// Business-plan deploy can add that as a second rule. In practice blind scanners hit "/" and
// common probe paths far more than they guess the /hook/ prefix, so default-deny captures the
// large majority of the wasted invocations on its own.
{
  "rules": [
    {
      "description": "[hookrelay] edge-block non-hook, non-admin paths",
      "expression": "(not starts_with(http.request.uri.path, \"/hook/\")) and (not starts_with(http.request.uri.path, \"/admin/\")) and (not starts_with(http.request.uri.path, \"/cdn-cgi/\"))",
      "action": "block"
    }
    // /admin/* is allowed through the WAF and gated by Cloudflare Access at the application
    // policy level (Access runs before the Worker, so unauthenticated /admin hits never reach
    // the Worker either). /cdn-cgi/* is Cloudflare's reserved path (Access login/callback).
    // /hook/* reaches the Worker, which verifies the slug against KV.
  ]
}
