// Copy this file to routes.jsonc, then use `pnpm sink:add` and `pnpm sub:add`
// sub:add discovers a single Cloudflare Worker custom domain for HTTP sources
{
  // Optional when automatic custom-domain discovery is unavailable or ambiguous
