// Copy this file to routes.jsonc, then use `pnpm sink:add` and `pnpm sub:add`
// sub:add discovers a single Cloudflare Worker custom domain for HTTP sources
{
  // Optional when automatic custom-domain discovery is unavailable or ambiguous
  // "baseUrl": "https://hooks.example.com",
  // Required for email subscriptions after Email Routing is configured
  // "emailBaseAddress": "relay@mail.example.com",
  "subs": [
    // `sub:add` writes subscriptions here; guarded email links can use this shape
    // {
    //   "name": "service-status",
    //   "source": "email",
    //   "slugHash": "<sha256-of-private-slug>",
    //   "enabled": true,
    //   "sinks": ["discord:service-status"],
    //   "fallbackUrl": "https://status.example.com/",
    //   "filter": {
    //     "eventTypes": {
    //       "include": ["email.received"]
    //     },
    //     "severities": {
    //       "exclude": ["debug"]
    //     }
    //   },
    //   "sinkFilters": {
    //     "ntfy:urgent": {
    //       "severities": {
    //         "include": ["error", "critical"]
    //       }
    //     }
    //   },
    //   "email": {
    //     "allowedSenders": ["@mailer.example.com"],
    //     "primaryLinkLabels": ["view incident"]
    //   }
    // },
    // {
    //   "name": "automation-events",
    //   "source": "cloudevents",
    //   "slugHash": "<sha256-of-private-slug>",
    //   "enabled": true,
    //   "sinks": ["automation"],
    //   "auth": {
    //     "scheme": "hookrelay-sha256",
    //     "secretEnv": "HMAC_AUTOMATION_EVENTS"
    //   }
    // }
  ],
  "sinks": [
    // `sink:add` writes only secret references for a signed webhook
    // {
    //   "name": "automation",
    //   "type": "webhook",
    //   "urlEnv": "SINK_AUTOMATION_URL",
    //   "signingSecretEnv": "SINK_AUTOMATION_SIGNING_SECRET"
    // }
  ]
}
