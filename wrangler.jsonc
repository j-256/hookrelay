{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hookrelay",
  "main": "src/index.ts",
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat"],

  // Opt out of Wrangler's anonymous usage telemetry for all deploys (local + Workers
  // Builds), so it travels with the repo rather than relying on a WRANGLER_SEND_METRICS
  // env var per environment. https://github.com/cloudflare/workers-sdk/tree/main/packages/wrangler/telemetry.md
  "send_metrics": false,

  // account_id is intentionally omitted: wrangler reads it from the
  // CLOUDFLARE_ACCOUNT_ID environment variable (set locally and in CI/Workers Builds)
  // The custom domain (route) is managed in the Cloudflare dashboard, not here, so
  // this file carries no account- or domain-identifying values
  "workers_dev": false,
  "preview_urls": false,

  "limits": {
    "cpu_ms": 1000,
    "subrequests": 1000
  },

  "ratelimits": [
    {
      "name": "HOOK_SOURCE_RATE_LIMITER",
      "namespace_id": "256001",
      "simple": { "limit": 2000, "period": 60 }
    },
    {
      "name": "HOOK_SUBSCRIPTION_RATE_LIMITER",
      "namespace_id": "256002",
      "simple": { "limit": 1200, "period": 60 }
    },
    {
      "name": "HOOK_RATE_LIMIT_SIGNAL",
      "namespace_id": "256003",
      "simple": { "limit": 1, "period": 60 }
    }
  ],

  // Replace these binding ids with your own after running the `wrangler ... create`
  // commands in the README. They are opaque resource handles, not secrets
  "kv_namespaces": [
    { "binding": "SUBS", "id": "2f3f7f1dca4f4b49b1818d06367ed513" },
    { "binding": "SINKS", "id": "724b83e413a34769aaafa17df58054f7" }
  ],
  "d1_databases": [
    {
      "binding": "EVENTS_DB",
      "database_name": "hookrelay-events",
      "database_id": "4ea9b8d9-5405-4fce-8615-7611016c1483",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    { "binding": "EVENTS_RAW", "bucket_name": "hookrelay-events-raw" }
  ],

  "queues": {
    "producers": [
      { "binding": "DELIVERY_QUEUE", "queue": "hookrelay-delivery" }
    ],
    "consumers": [
      {
        "queue": "hookrelay-delivery",
        "max_batch_size": 5,
        "max_batch_timeout": 1,
        "max_retries": 8,
        "dead_letter_queue": "hookrelay-delivery-dlq"
      },
      {
        "queue": "hookrelay-delivery-dlq",
        "max_batch_size": 10,
        "max_batch_timeout": 5,
        "max_retries": 100
      }
    ]
  },

  "triggers": {
    "crons": ["*/5 * * * *"]
  },

  // Raw producer telemetry is transient; only the Tail Worker's safe summaries persist
  // Deploy the selected sanitizing service before attaching this producer
  "tail_consumers": [{ "service": "hookrelay-telemetry" }],
  "logpush": false,
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": { "enabled": true, "invocation_logs": false, "persist": false },
    "traces": { "enabled": false, "persist": false },
    "issues": { "enabled": false }
  },

  // CF_ACCESS_TEAM_DOMAIN and CF_ACCESS_AUD are set as Wrangler secrets, not vars,
  // so they never live in source:
  //   npx wrangler secret put CF_ACCESS_TEAM_DOMAIN
  //   npx wrangler secret put CF_ACCESS_AUD
  // For local `wrangler dev`, put them in .dev.vars (gitignored)
}
